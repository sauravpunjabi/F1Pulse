# ───────────────────────────────────────────────────────────────────────────
# F1Pulse — Server (apps/server)
# Copy to .env for local dev. This is the ONLY place third-party URLs/keys live.
# ───────────────────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=4000

# Origin of apps/web — CORS is locked to this.
WEB_ORIGIN=http://localhost:3000

# Local infra (matches docker-compose.yml). Start it with: pnpm db:up
DATABASE_URL=postgresql://f1pulse:f1pulse@localhost:5432/f1pulse?schema=public
REDIS_URL=redis://localhost:6379

# Third-party data sources — SERVER-ONLY. Never expose these to the browser.
# Jolpica (Ergast-compatible): history, schedule, standings, results (1950→present).
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
# OpenF1: live sessions / telemetry (race weekends only).
OPENF1_BASE_URL=https://api.openf1.org/v1

# Cache purge guard. Required for DELETE /api/cache/purge. Use a strong random value in production.
ADMIN_TOKEN=change-me-in-production
