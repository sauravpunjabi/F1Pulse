{
  "name": "f1pulse",
  "version": "0.1.0",
  "private": true,
  "description": "F1Pulse — a cinematic, immersive Formula 1 platform (live 2026 + history 1950→present).",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "concurrently -n web,server -c blue,magenta \"pnpm --filter @f1pulse/web dev\" \"pnpm --filter @f1pulse/server dev\"",
    "dev:web": "pnpm --filter @f1pulse/web dev",
    "dev:server": "pnpm --filter @f1pulse/server dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v",
    "ingest:current": "pnpm --filter @f1pulse/server ingest:current",
    "verify:current": "pnpm --filter @f1pulse/server verify:current"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "msgpackr-extract",
      "unrs-resolver"
    ]
  }
}
